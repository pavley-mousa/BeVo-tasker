NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Canonical URL: use your own verified custom domain before applying to AdSense.
NEXT_PUBLIC_SITE_URL=https://your-owned-domain.com

# Public contact displayed on /contact. Set a real monitored support address before review.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Set the client ID when AdSense provides it; it also enables the site ownership meta tag. Set the slot only after creating an ad unit.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_GUIDES_SLOT_ID=
ADSENSE_PUBLISHER_ID=
